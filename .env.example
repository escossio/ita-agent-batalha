# Configuração não secreta; credenciais locais são geradas em volume isolado.
ITA_PORT=8080
# ITA_CI_WORKERS deve ser definido externamente no AGT; não versionar hosts/IPs.
# Mock explícito para certificação sem credenciais; nunca fallback automático.
ITA_MODEL_PROVIDER=mock
# Vertex real: projeto, região e modelo definidos externamente; autenticação ADC/identidade.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# ITA_VERTEX_MODEL=
# Inventário BigQuery (somente metadados); separado da região do modelo.
# ITA_BIGQUERY_PROJECT=       # aceita GOOGLE_CLOUD_PROJECT como default no coletor
# ITA_BIGQUERY_DATASET=
# ITA_BIGQUERY_LOCATION=      # conferir com a localização retornada pelo inventário
# Adapter Data conectado via Broker/Policy; compose.bigquery.yaml exige identidade externa.
# ITA_BIGQUERY_TABLE=
# ITA_BIGQUERY_CURRENCY=BRL
# ITA_BIGQUERY_MONEY_UNIT=major
# ITA_BIGQUERY_MAX_BYTES_BILLED=  # orçamento obrigatório escolhido pelo operador
# BRL/major são confirmação explícita de moeda/unidade, ausentes no metadata.

# Modo competition: registry privado fora do Git, com hashes de sessão/vínculos/validade.
# ITA_IDENTITY_REGISTRY_FILE=
# ITA_DATA_PROVIDER=bigquery
# CI apenas: bigquery_mock + ITA_BIGQUERY_MOCK_ROWS_FILE externo.
# Chaves HMAC são exclusivas do Compose. Cloud Run usa ID tokens/IAM; veja infra/gcp/cloudrun/env.example.

# PORT é injetado pelo Cloud Run; default local 8080. ITA_PLATFORM=cloudrun é opt-in.
# URLs ITA_<SERVICE>_URL vêm de status.url do Cloud Run, sem caminho/barra final.
