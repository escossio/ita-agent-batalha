# Configuração não secreta; credenciais locais são geradas em volume isolado.
ITA_PORT=8080
# ITA_CI_WORKERS deve ser definido externamente no AGT; não versionar hosts/IPs.
# Mock explícito para certificação sem credenciais; nunca fallback automático.
ITA_MODEL_PROVIDER=mock
# Vertex real: projeto, região e modelo definidos externamente; autenticação ADC/identidade.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# ITA_VERTEX_MODEL=
# Inventário BigQuery (somente metadados); separado da região do modelo.
# ITA_BIGQUERY_PROJECT=       # aceita GOOGLE_CLOUD_PROJECT como default no coletor
# ITA_BIGQUERY_DATASET=
# ITA_BIGQUERY_LOCATION=      # conferir com a localização retornada pelo inventário
# Adapter financeiro BigQuery ainda não ativado: depende do schema inspecionado.
