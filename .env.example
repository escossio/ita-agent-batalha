# Configuração não secreta; credenciais locais são geradas em volume isolado.
ITA_PORT=8080
# ITA_CI_WORKERS deve ser definido externamente no AGT; não versionar hosts/IPs.
# Mock explícito para certificação sem credenciais; nunca fallback automático.
ITA_MODEL_PROVIDER=mock
