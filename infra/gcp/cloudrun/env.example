# Non-secret operator configuration; keep completed copies outside Git.
# Shared project/source are READ_ONLY. The guard pins this authorized scope.
ITA_GCP_PROJECT=batalha-time-01-97zr
ITA_GCP_REGION=us-central1
ITA_RESOURCE_PREFIX=ita-escossio
ITA_ARTIFACT_REPOSITORY=ita-escossio
ITA_BIGQUERY_DATASET=hackathon_dados
ITA_BIGQUERY_TABLE=extrato_sintetico
ITA_BIGQUERY_CURRENCY=BRL
ITA_BIGQUERY_MONEY_UNIT=major
ITA_BIGQUERY_MAX_BYTES_BILLED=
ITA_VERTEX_MODEL=
ITA_CERTIFIED_SHA=
# Routable endpoints still require IAM; no VPC dependency.
ITA_CLOUD_RUN_INGRESS=all
# Future OWN secret only, with ownership labels. IdentityRegistry, never ADC keys.
ITA_IDENTITY_SECRET=ita-escossio-identity-registry
ITA_IDENTITY_SECRET_VERSION=
ITA_DEPLOYMENT_MANIFEST=.artifacts/cloudrun/images.json
# Smoke only, after separate authorization. Session file chmod 600, outside Git.
ITA_SMOKE_SESSION_FILE=
ITA_SMOKE_FROM=
ITA_SMOKE_TO=
