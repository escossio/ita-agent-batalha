# External configuration. Copy outside Git and source there; never add credentials.
ITA_GCP_PROJECT=
ITA_GCP_REGION=us-central1
ITA_BIGQUERY_DATASET=
ITA_BIGQUERY_TABLE=
ITA_BIGQUERY_CURRENCY=BRL
ITA_BIGQUERY_MONEY_UNIT=major
ITA_BIGQUERY_MAX_BYTES_BILLED=
ITA_VERTEX_MODEL=
ITA_ARTIFACT_REPOSITORY=
ITA_CERTIFIED_SHA=
# Only isolated previews accepted by deploy/destroy tooling.
ITA_CLOUD_RUN_PREFIX=ita-preview-readiness
# all permits IAM-authenticated cross-service calls without VPC. Not anonymous.
ITA_CLOUD_RUN_INGRESS=all
# Existing private Secret Manager resource containing IdentityRegistry, NOT ADC keys.
ITA_IDENTITY_SECRET=
ITA_IDENTITY_SECRET_VERSION=
# Output/input provenance file, ignored by Git. Do not overwrite old manifests.
ITA_DEPLOYMENT_MANIFEST=.artifacts/cloudrun/images.json
# Smoke only: opaque end-user session provisioned outside Git; file chmod 600.
ITA_SMOKE_SESSION_FILE=
ITA_SMOKE_FROM=
ITA_SMOKE_TO=
